# Application
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Kolkata
APP_DEBUG=false
APP_KEY=replace-with-a-random-32-character-secret

# Sub-folder base path, only needed if auto-detection fails on your host
# (site at https://example.com/school -> set "/school"). Leave empty at the
# domain root. Links, redirects and uploaded images follow it automatically.
APP_BASE_URL=

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mount_heaven_school
DB_USER=root
DB_PASS=

# Used only during the first install
ADMIN_NAME=Administrator
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@mountheaven.edu
ADMIN_PASSWORD=replace-with-a-strong-password
