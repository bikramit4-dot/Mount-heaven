# Uploads: serve images only — never execute scripts here

<FilesMatch "\.(php|phtml|php3|php4|php5|php7|phps|cgi|pl|py|sh|asp|aspx|jsp)$">
  Require all denied
</FilesMatch>

<IfModule mod_php.c>
  php_flag engine off
</IfModule>

# Block PHP-like double extensions too
<FilesMatch "\.(php|phtml)\..*$">
  Require all denied
</FilesMatch>
